        },
        "whyBestFit": {
          "type": "string",
          "description": "Why the applicant is the best fit for coaching"
        },
        "budget": {
          "type": "string",
          "description": "Investment budget range"
        },
        "startMonth": {
          "type": "string",
          "description": "Target start month (YYYY-MM)"
        },
        "createdAt": {
          "type": "number",
          "description": "Creation timestamp in milliseconds"
        }
      },
      "required": [
        "name",
        "zalo",
        "hoursPerDay",
        "journey",
        "whyBestFit",
        "budget",
        "startMonth",
        "createdAt"
      ]
    },
    "CoachingSettings": {
      "title": "CoachingSettings",
      "description": "Slot counter configuration for 1:1 coaching.",
      "type": "object",
      "properties": {
        "slotsFilled": {
          "type": "number",
          "description": "Number of coaching slots currently filled"
        },
        "slotsTotal": {
          "type": "number",
          "description": "Total number of coaching slots available"
        }
      },
      "required": ["slotsFilled", "slotsTotal"]
    },
    "AdminEntry": {
      "title": "AdminEntry",
      "description": "Allowlisted admin user document keyed by email.",
      "type": "object",
      "properties": {
        "role": {
          "type": "string",
          "description": "Optional role label"
        }
      }
    }
  },
  "firestore": {
    "/waitlist/{docId}": {
      "schema": { "$ref": "#/entities/WaitlistEntry" },
      "description": "Public coaching waitlist entries"
    },
    "/settings/{docId}": {
      "schema": { "$ref": "#/entities/CoachingSettings" },
      "description": "Coaching slot settings"
    },
    "/admins/{email}": {
      "schema": { "$ref": "#/entities/AdminEntry" },
      "description": "Admin allowlist keyed by email"
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isRootAdmin() {
      return request.auth != null
        && (request.auth.token.email == 'ntunga.26@gmail.com'
            || request.auth.token.email == 'tunganhhh.nl@gmail.com');
    }

    function isAdmin() {
      return request.auth != null && (
        isRootAdmin()
        || exists(/databases/$(database)/documents/admins/$(request.auth.token.email))
      );
    }

    // Public waitlist: anyone can read and submit; only admins can modify or delete
    match /waitlist/{docId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Slot counter: public read, admin write
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admin allowlist: only the root admin manages it
    match /admins/{email} {
      allow read: if isAdmin();
      allow create, update, delete: if isRootAdmin();
    }
  }
}

