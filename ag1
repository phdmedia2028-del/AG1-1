import React, { useState } from "react";
import { X, ArrowRight, Loader2, Check, MessageCircle } from "lucide-react";
import { addToWaitlist } from "../waitlistSheet";

const ZALO_LINK = "https://zalo.me/0812338344";

interface Props {
  open: boolean;
  onClose: () => void;
  onSubmitted?: () => void;
}

const inputClass =
  "w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-sm text-[#F5F4F0] placeholder:text-slate-600 focus:outline-none focus:border-[#C9A961]/60 focus:ring-2 focus:ring-[#C9A961]/15 transition-all";

export default function WaitlistModal({ open, onClose, onSubmitted }: Props) {
  const [name, setName] = useState("");
  const [zalo, setZalo] = useState("");
  const [error, setError] = useState("");
  const [submitting, setSubmitting] = useState(false);
  const [result, setResult] = useState<{ position: number; duplicate: boolean } | null>(null);

  if (!open) return null;

  const resetAndClose = () => {
    if (submitting) return;
    setName(""); setZalo(""); setError(""); setResult(null);
    onClose();
  };

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    setError("");
    const cleanName = name.trim().replace(/\s+/g, " ");
    const digits = zalo.replace(/\D/g, "");
    if (!cleanName) { setError("Vui lòng nhập họ và tên."); return; }
    if (digits.length < 9 || digits.length > 12) { setError("Số Zalo chưa hợp lệ. Vui lòng kiểm tra lại."); return; }

    setSubmitting(true);
    try {
      const r = await addToWaitlist(cleanName, digits);
      setResult(r);
      onSubmitted?.();
    } catch (err) {
      const msg = err instanceof Error ? err.message : "";
      // Mã lỗi giúp admin biết nguyên nhân; khách chỉ cần thử lại hoặc nhắn Zalo
      const code =
        err instanceof TypeError ? "KHÔNG KẾT NỐI ĐƯỢC MÁY CHỦ"
        : /Thiếu thông tin bắt buộc/.test(msg) ? "APPS SCRIPT CHƯA CẬP NHẬT CODE HÀNG CHỜ"
        : /permission|quyền|Exception/i.test(msg) ? "APPS SCRIPT CHƯA CÓ QUYỀN SỬA SHEET HÀNG CHỜ"
        : msg || "KHÔNG RÕ";
      setError(`Chưa gửi được đăng ký. Vui lòng thử lại sau ít phút hoặc nhắn Zalo để được hỗ trợ. (Mã lỗi: ${code})`);
    }
    setSubmitting(false);
  };

  return (
    <div
      className="fixed inset-0 z-[10000] flex items-end sm:items-center justify-center sm:p-4 bg-black/70 backdrop-blur-sm"
      onClick={resetAndClose}
    >
      <div
        className="relative w-full sm:max-w-md bg-[#14130F] border border-[#C9A961]/30 rounded-t-3xl sm:rounded-3xl shadow-2xl max-h-[92vh] overflow-y-auto"
        onClick={(e) => e.stopPropagation()}
      >
        <button
          onClick={resetAndClose}
          className="absolute top-4 right-4 w-9 h-9 rounded-full bg-white/5 border border-[#C9A961]/20 flex items-center justify-center text-slate-400 hover:text-[#C9A961] hover:border-[#C9A961]/50 transition-all cursor-pointer z-10"
          aria-label="Đóng"
        >
          <X className="w-4 h-4" />
        </button>

        {result ? (
          <div className="p-7 sm:p-9 text-center space-y-6">
            <div className="w-16 h-16 rounded-full bg-[#C9A961]/15 border border-[#C9A961]/40 flex items-center justify-center mx-auto">
              <Check className="w-8 h-8 text-[#C9A961]" />
            </div>
            <div className="space-y-2">
              <h3 className="font-display font-extrabold text-2xl text-[#F5F4F0]">
                {result.duplicate ? "Bạn đã có trong hàng chờ" : "Bạn đã vào hàng chờ"}
              </h3>
              {result.position > 0 && (
                <>
                  <p className="text-slate-400 text-sm">Vị trí của bạn trong danh sách</p>
                  <div className="font-display font-extrabold text-5xl text-[#C9A961] py-2">#{result.position}</div>
                </>
              )}
            </div>
            <div className="bg-white/5 border border-[#C9A961]/20 rounded-2xl p-5 text-left">
              <p className="text-sm text-slate-300 leading-relaxed">
                Khi slot coaching mở lại, Hiếu sẽ liên hệ với bạn qua Zalo theo thứ tự trong hàng chờ. Hãy để ý tin nhắn Zalo của bạn nhé.
              </p>
            </div>
            <a
              href={ZALO_LINK}
              target="_blank"
              rel="noopener noreferrer"
              className="w-full inline-flex items-center justify-center px-6 py-3.5 rounded-xl text-sm font-bold bg-white/5 border border-[#C9A961]/30 text-[#C9A961] hover:bg-[#C9A961]/10 transition-all cursor-pointer"
            >
              <MessageCircle className="w-4 h-4 mr-2" />
              Mở Zalo của Hiếu
            </a>
            <button onClick={resetAndClose} className="text-xs text-slate-500 hover:text-slate-300 transition-colors cursor-pointer">
              Đóng cửa sổ này
            </button>
          </div>
        ) : (
          <form onSubmit={handleSubmit} className="p-7 sm:p-9 space-y-5">
            <div className="space-y-1.5 pr-10">
              <span className="text-[10px] font-bold uppercase tracking-widest text-[#C9A961]">Đăng ký hàng chờ Coaching</span>
              <h3 className="font-display font-extrabold text-xl text-[#F5F4F0]">Điền tên để giữ chỗ</h3>
              <p className="text-sm text-slate-400 font-light">
                Tên của bạn sẽ hiện trong danh sách hàng chờ. Số Zalo chỉ dùng để Hiếu liên hệ, không hiển thị công khai.
              </p>
            </div>

            <div className="space-y-1.5">
              <label htmlFor="wl-name" className="text-xs font-semibold text-slate-300">Họ và tên *</label>
              <input id="wl-name" className={inputClass} value={name} onChange={(e) => setName(e.target.value)}
                placeholder="Nguyễn Văn A" autoComplete="name" maxLength={80} />
            </div>
            <div className="space-y-1.5">
              <label htmlFor="wl-zalo" className="text-xs font-semibold text-slate-300">Số Zalo *</label>
              <input id="wl-zalo" className={inputClass} value={zalo} onChange={(e) => setZalo(e.target.value)}
                placeholder="09xx xxx xxx" inputMode="numeric" autoComplete="tel" />
            </div>

            {error && <p className="text-xs text-red-400">{error}</p>}

            <button
              type="submit"
              disabled={submitting}
              className="w-full inline-flex items-center justify-center h-12 rounded-xl text-sm font-bold bg-[#C9A961] hover:bg-[#A98B45] disabled:opacity-60 text-[#14130F] uppercase tracking-wider transition-all cursor-pointer"
            >
              {submitting ? <Loader2 className="w-4 h-4 animate-spin" /> : <>Vào hàng chờ <ArrowRight className="w-4 h-4 ml-2" /></>}
            </button>
          </form>
        )}
      </div>
    </div>
  );
}

