    });
    return init;
  });
  const [introText, setIntroText] = useState("");
  const [copyState, setCopyState] = useState<"idle" | "copied" | "blocked">("idle");
  const [showComposer, setShowComposer] = useState(false);
  const [openDropdown, setOpenDropdown] = useState<string | null>(null);
  const introRef = useRef<HTMLTextAreaElement>(null);

  const transferContent = buildTransferContent(phone, discord);

  /* --- Khôi phục bản nháp khi mở lại --- */
  useEffect(() => {
    if (!open) return;
    try {
      const raw = localStorage.getItem(DRAFT_KEY);
      if (raw) {
        const d = JSON.parse(raw);
        setName(d.name || "");
        setPhone(d.phone || "");
        setDiscord(d.discord || "");
        setEmail(d.email || "");
        setFacebook(d.facebook || "");
      }
    } catch { /* localStorage không dùng được, bỏ qua */ }
  }, [open]);

  /* --- Lưu nháp mỗi khi đổi thông tin ở bước 1 --- */
  useEffect(() => {
    if (!open) return;
    try {
      localStorage.setItem(
        DRAFT_KEY,
        JSON.stringify({ name, phone, discord, email, facebook })
      );
    } catch { /* bỏ qua */ }
  }, [open, name, phone, discord, email, facebook]);

  /* --- Khoá cuộn nền + phím Escape + autofocus --- */
  useEffect(() => {
    if (!open) return;
    const prevOverflow = document.body.style.overflow;
    document.body.style.overflow = "hidden";

    const onKey = (e: KeyboardEvent) => {
      if (e.key === "Escape") attemptClose();
    };
    document.addEventListener("keydown", onKey);

    const t = setTimeout(() => nameInputRef.current?.focus(), 120);

    return () => {
      document.body.style.overflow = prevOverflow;
      document.removeEventListener("keydown", onKey);
      clearTimeout(t);
    };
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [open, step]);

  /* --- Nhắc trước khi đóng ở bước 2 (có thể đã chuyển khoản) --- */
  const attemptClose = () => {
    if (step === 2) {
      const ok = window.confirm(
        "Bạn đang ở bước gửi xác nhận. Nếu đã chuyển khoản mà chưa gửi bill, team sẽ không biết để duyệt.\n\nVẫn đóng cửa sổ này?"
      );
      if (!ok) return;
    }
    if (step === 3) {
      try { localStorage.removeItem(DRAFT_KEY); } catch { /* bỏ qua */ }
    }
    setStep(1);
    setError("");
    setBillFile(null);
    setBillPreview("");
    onClose();
  };

  /* --- Tích / bỏ tích một ý --- */
  const toggleIntro = (key: string, value: string, multi: boolean) => {
    setIntroSel((prev) => {
      if (!multi) return { ...prev, [key]: [value] };
      const cur = prev[key] || [];
      return {
        ...prev,
        [key]: cur.includes(value)
          ? cur.filter((v) => v !== value)
          : [...cur, value],
      };
    });
  };

  /* --- Ghép bài viết mỗi khi đổi lựa chọn --- */
  useEffect(() => {
    if (step !== 3) return;
    const role = introSel.role || [];
    const goal = introSel.goal || [];
    const exp = (introSel.exp || [])[0];
    const time = (introSel.time || [])[0];
    const wish = introSel.wish || [];

    const lines: string[] = ["Chào cả nhà AG1 👋"];
    lines.push(
      `Mình là ${name.trim() || "[tên của bạn]"}${role.length ? ", " + joinVi(role) : ""}.`
    );
    if (goal.length) lines.push(`Mình tham gia cộng đồng để ${joinVi(goal)}.`);
    if (exp) lines.push(`Hiện tại ${exp}.`);
    if (time) lines.push(`Mỗi ngày mình dành ${time} cho việc này.`);
    if (wish.length) lines.push(`Mong muốn của mình là ${joinVi(wish)}.`);
    lines.push("Rất vui được làm quen và đồng hành cùng mọi người! 🚀");
    lines.push("", "#1PercentAffiliate #ThanhVienMoi");

    setIntroText(lines.join("\n"));
  }, [step, introSel, name]);

  /* --- Sao chép bài và mở group Facebook trong cùng một cú bấm --- */
  const handleCopyAndOpen = () => {
    const text = introText.trim();

    // Sao chép đồng bộ trước để trình duyệt không chặn
    let copied = false;
    const ta = introRef.current;
    if (ta) {
      ta.focus();
      ta.select();
      try {
        copied = document.execCommand("copy");
      } catch {
        /* bỏ qua */
      }
      ta.setSelectionRange(0, 0);
      ta.blur();
    }
    // Cách hiện đại làm dự phòng
    if (navigator.clipboard) {
      navigator.clipboard.writeText(text).catch(() => {});
      copied = true;
    }

    // Mở Facebook ngay trong cùng cú bấm, nếu không trình duyệt sẽ chặn
    const win = window.open(CONFIG.facebookGroup, "_blank", "noopener");

    if (win) {
      setCopyState("copied");
      setTimeout(() => setCopyState("idle"), 4000);
    } else {
      // Trình duyệt chặn tab mới — giữ trạng thái để hiện nút dự phòng
      setCopyState("blocked");
    }
  };

  if (!open) return null;

  /* --- Bước 1 → 2 --- */
  const goToStep2 = () => {
    setError("");
    if (!name.trim()) { setError("Vui lòng nhập họ và tên."); return; }
    const d = onlyDigits(phone);
    if (d.length < 9 || d.length > 11) {
      setError("Số điện thoại chưa đúng, vui lòng kiểm tra lại."); return;
    }
    if (!discord.trim()) { setError("Vui lòng nhập tên Discord."); return; }
    setQrFailed(false);
    setStep(2);
  };

  /* --- Chọn ảnh bill --- */
  const handlePickFile = (e: React.ChangeEvent<HTMLInputElement>) => {
    setError("");
    const f = e.target.files?.[0];
    if (!f) return;
    if (!f.type.startsWith("image/")) {
      setError("File bill phải là ảnh (JPG, PNG...)."); return;
    }
    if (f.size > 10 * 1024 * 1024) {
      setError("Ảnh bill lớn hơn 10MB, vui lòng chụp lại hoặc nén ảnh."); return;
    }
    setBillFile(f);
    const reader = new FileReader();
    reader.onload = () => setBillPreview(reader.result as string);
    reader.readAsDataURL(f);
  };

  /* --- Gửi dữ liệu --- */
  const handleSubmit = async () => {
    setError("");
    if (!billFile) { setError("Vui lòng tải lên ảnh bill chuyển khoản."); return; }
    if (!CONFIG.sheetWebAppUrl) {
      setError("Chưa cấu hình link Google Sheet. Vui lòng nhắn Zalo để được hỗ trợ."); return;
    }

    setSubmitting(true);
    try {
      const compressed = await compressImage(billFile);

      const res = await fetch(CONFIG.sheetWebAppUrl, {
        method: "POST",
        headers: { "Content-Type": "text/plain;charset=utf-8" },
        body: JSON.stringify({
          name: name.trim(),
          phone: onlyDigits(phone),
          discord: discord.trim(),
          email: email.trim(),
          facebook: facebook.trim(),
          amount: CONFIG.price,
          transferContent,
          source: window.location.href,
          billName: compressed.name,
          billType: compressed.type,
          billBase64: compressed.base64,
        }),
      });

      const json = await res.json().catch(() => null);
      if (json && json.ok) {
        setStep(3);
      } else {
        setError("Gửi chưa thành công. Vui lòng thử lại hoặc nhắn Zalo để được hỗ trợ.");
      }
    } catch {
      setError("Gửi chưa thành công. Vui lòng thử lại hoặc nhắn Zalo để được hỗ trợ.");
    }
    setSubmitting(false);
  };

  const inputClass =
    "w-full bg-white/5 border border-white/15 rounded-xl px-4 py-3 text-sm text-[#F5F4F0] placeholder:text-slate-500 focus:outline-none focus:border-[#C9A961] focus:ring-2 focus:ring-[#C9A961]/25 transition-all";
  const labelClass = "text-xs font-semibold text-slate-300 block mb-1.5";
  const primaryBtn =
    "w-full inline-flex items-center justify-center px-6 py-3.5 rounded-xl text-sm font-bold bg-[#C9A961] hover:bg-[#A98B45] active:scale-[0.98] text-[#14130F] transition-all cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed uppercase tracking-wide";

  return (
    <div
      className="fixed inset-0 z-[10000] flex items-start sm:items-center justify-center p-4 bg-black/75 backdrop-blur-sm overflow-y-auto"
      onClick={attemptClose}
      role="dialog"
      aria-modal="true"
      aria-label="Tham gia membership"
    >
      <div
        className="relative w-full max-w-lg my-auto bg-[#14130F] border border-[#C9A961]/30 rounded-3xl shadow-2xl"
        onClick={(e) => e.stopPropagation()}
      >
        {/* Nút đóng */}
        <button
          type="button"
          onClick={attemptClose}
          aria-label="Đóng"
          className="absolute top-4 right-4 w-9 h-9 rounded-full bg-white/5 border border-[#C9A961]/20 flex items-center justify-center text-slate-400 hover:text-[#C9A961] hover:border-[#C9A961]/50 transition-all cursor-pointer z-10"
        >
          <X className="w-4 h-4" />
        </button>

        <div className="p-7 sm:p-9">
          {/* Thanh tiến trình — ẩn ở bước 3 */}
          {step < 3 && (
            <div className="space-y-2 mb-7 pr-10">
              <div className="flex items-center justify-between text-[10px] font-bold uppercase tracking-widest text-[#C9A961]">
                <span>{step === 1 ? "Bước 1 · Thông tin" : "Bước 2 · Chuyển khoản"}</span>
                <span>{step}/2</span>
              </div>
              <div className="h-1 w-full bg-white/10 rounded-full overflow-hidden">
                <div
                  className="h-full bg-[#C9A961] rounded-full transition-all duration-300"
                  style={{ width: `${(step / 2) * 100}%` }}
                />
              </div>
            </div>
          )}

          {/* ====================== BƯỚC 1 ====================== */}
          {step === 1 && (
            <div className="space-y-5">
              <div className="space-y-1.5">
                <h3 className="font-display font-extrabold text-xl text-[#F5F4F0]">
                  {CONFIG.planName} · {formatPrice(CONFIG.price)}
                </h3>
                <p className="text-sm text-slate-400 font-light">
                  Một lần duy nhất, truy cập mãi mãi. Điền thông tin để team duyệt và thêm bạn vào cộng đồng.
                </p>
              </div>

              <div className="space-y-3.5">
                <div>
                  <label className={labelClass} htmlFor="pm-name">Họ và tên *</label>
                  <input
                    id="pm-name" ref={nameInputRef} className={inputClass}
                    value={name} onChange={(e) => setName(e.target.value)}
                    placeholder="Nguyễn Văn A" autoComplete="name"
                  />
                </div>

                <div>
                  <label className={labelClass} htmlFor="pm-phone">Số điện thoại (Zalo) *</label>
                  <input
                    id="pm-phone" className={inputClass} inputMode="tel"
                    value={phone} onChange={(e) => setPhone(e.target.value)}
                    placeholder="09xx xxx xxx" autoComplete="tel"
                  />
                </div>

                <div>
                  <label className={labelClass} htmlFor="pm-discord">Tên Discord *</label>
                  <input
                    id="pm-discord" className={inputClass}
                    value={discord} onChange={(e) => setDiscord(e.target.value)}
                    placeholder="vd: nolanj"
                  />
                  <div className="flex items-start gap-1.5 mt-2 px-1">
                    <Info className="w-3.5 h-3.5 text-[#C9A961] shrink-0 mt-0.5" />
                    <p className="text-[11px] text-slate-500 leading-relaxed">
                      Nhập <strong className="text-slate-400">username</strong> (chữ thường, không dấu cách), không phải tên hiển thị.
                      Xem tại Discord → Cài đặt → Tài khoản. Team duyệt yêu cầu tham gia server theo đúng tên này.
                    </p>
                  </div>
                </div>

                <div>
                  <label className={labelClass} htmlFor="pm-email">Email</label>
                  <input
                    id="pm-email" type="email" className={inputClass}
                    value={email} onChange={(e) => setEmail(e.target.value)}
                    placeholder="ban@email.com" autoComplete="email"
                  />
                </div>

                <div>
                  <label className={labelClass} htmlFor="pm-fb">Link Facebook cá nhân</label>
                  <input
                    id="pm-fb" className={inputClass}
                    value={facebook} onChange={(e) => setFacebook(e.target.value)}
                    placeholder="facebook.com/ten-cua-ban"
                  />
                </div>
              </div>

              {error && (
                <div className="flex items-start gap-2 text-xs text-red-400">
                  <AlertCircle className="w-4 h-4 shrink-0 mt-0.5" />
                  <span className="leading-relaxed">{error}</span>
                </div>
              )}

              <button type="button" onClick={goToStep2} className={primaryBtn}>
                Tiếp tục <ArrowRight className="w-4 h-4 ml-2" />
              </button>
            </div>
          )}

          {/* ====================== BƯỚC 2 ====================== */}
          {step === 2 && (
            <div className="space-y-5">
              <div className="space-y-1.5">
                <h3 className="font-display font-extrabold text-xl text-[#F5F4F0]">
                  Chuyển {formatPrice(CONFIG.price)}
                </h3>
                <p className="text-sm text-slate-400 font-light">
                  {CONFIG.qrImageUrl
                    ? "Mở app ngân hàng → Quét mã QR, nhập đúng số tiền và nội dung CK bên dưới."
                    : "Mở app ngân hàng → Quét mã QR (đã có sẵn số tiền và nội dung)."}
                </p>
              </div>

              {/* Mã QR */}
              <div className="bg-white rounded-2xl p-4 flex items-center justify-center">
                {qrFailed ? (
                  <div className="text-center py-8 px-4 space-y-2">
                    <AlertCircle className="w-7 h-7 text-amber-500 mx-auto" />
                    <p className="text-xs text-slate-600 leading-relaxed max-w-[220px]">
                      Không tải được mã QR. Vui lòng chuyển khoản thủ công theo thông tin bên dưới.
                    </p>
                  </div>
                ) : (
                  <img
                    src={buildQrUrl(transferContent)}
                    alt="Mã QR chuyển khoản"
                    onError={() => setQrFailed(true)}
                    className="w-full max-w-[240px] h-auto"
                    style={{ imageRendering: CONFIG.qrImageUrl ? "pixelated" : "auto" }}
                  />
                )}
              </div>

              {/* Thông tin tài khoản */}
              <div className="space-y-2.5">
                <InfoRow label="Ngân hàng" value={CONFIG.bankName} />
                <InfoRow label="Số tài khoản" value={CONFIG.accountNo} mono copyable />
                <InfoRow label="Chủ tài khoản" value={CONFIG.accountName} />
                <InfoRow label="Nội dung CK" value={transferContent} mono highlight copyable />
              </div>

              <p className="text-[11px] text-slate-500 leading-relaxed px-1">
                Nội dung chuyển khoản gồm số điện thoại và tên Discord bạn vừa nhập. Ghi đúng nội dung này giúp team đối soát nhanh hơn.
              </p>

              {/* Upload bill */}
              <div className="space-y-2 pt-2 border-t border-white/10">
                <label className={labelClass}>Ảnh bill chuyển khoản *</label>
                <input
                  ref={fileInputRef} type="file" accept="image/*"
                  onChange={handlePickFile} className="hidden"
                />
                {billPreview ? (
                  <div className="space-y-2.5">
                    <img
                      src={billPreview} alt="Ảnh bill đã chọn"
                      className="max-h-36 w-auto rounded-xl border border-[#C9A961]/25 mx-auto"
                    />
                    <div className="flex items-center justify-between gap-3 text-xs">
                      <span className="text-slate-400 truncate">{billFile?.name}</span>
                      <button
                        type="button"
                        onClick={() => fileInputRef.current?.click()}
                        className="shrink-0 font-bold text-[#C9A961] hover:text-[#A98B45] hover:underline cursor-pointer"
                      >
                        Chọn ảnh khác
                      </button>
                    </div>
                  </div>
                ) : (
                  <button
                    type="button"
                    onClick={() => fileInputRef.current?.click()}
                    className="w-full border-2 border-dashed border-[#C9A961]/40 rounded-2xl py-7 flex flex-col items-center gap-2 hover:border-[#C9A961] hover:bg-[#C9A961]/5 transition-all cursor-pointer"
                  >
                    <Upload className="w-6 h-6 text-[#C9A961]" />
                    <span className="text-xs text-slate-400">
                      Bấm để chọn ảnh (JPG, PNG)
                    </span>
                  </button>
                )}
              </div>

              {error && (
                <div className="flex items-start gap-2 text-xs text-red-400">
                  <AlertCircle className="w-4 h-4 shrink-0 mt-0.5" />
                  <span className="leading-relaxed">{error}</span>
                </div>
              )}

              <button
                type="button" onClick={handleSubmit} disabled={submitting}
                className={primaryBtn}
              >
                {submitting ? (
                  <><Loader2 className="w-4 h-4 animate-spin mr-2" /> Đang gửi…</>
                ) : (
                  <>Gửi xác nhận thanh toán <ArrowRight className="w-4 h-4 ml-2" /></>
                )}
              </button>

              <button
                type="button" onClick={() => { setError(""); setStep(1); }}
                className="inline-flex items-center text-xs text-slate-500 hover:text-slate-300 transition-colors cursor-pointer"
              >
                <ArrowLeft className="w-3.5 h-3.5 mr-1" /> Sửa lại thông tin
              </button>
            </div>
          )}

          {/* ====================== BƯỚC 3 — MÀN HÌNH THÀNH CÔNG ====================== */}
          {step === 3 && (
            <div className="space-y-5">
              {/* Lời xác nhận & giải thích quy trình */}
              <div className="text-center space-y-3">
                <div className="w-14 h-14 rounded-full bg-[#C9A961]/15 border border-[#C9A961]/40 flex items-center justify-center mx-auto shadow-lg shadow-[#C9A961]/10">
                  <CircleCheck className="w-7 h-7 text-[#C9A961]" />
                </div>
                <h3 className="font-display font-extrabold text-xl text-[#F5F4F0] tracking-tight">
                  Đã nhận thông tin &amp; thanh toán!
                </h3>
                <div className="bg-white/[0.04] border border-white/10 rounded-2xl p-4 text-left space-y-2">
                  <p className="text-xs text-slate-300 leading-relaxed">
                    Cảm ơn bạn <span className="text-[#C9A961] font-semibold">{name.trim()}</span>! Team đang tiến hành đối soát bill thanh toán. Sau khi xác nhận xong, team sẽ duyệt bạn vào nhóm Facebook cộng đồng.
                  </p>
                  <p className="text-xs text-slate-400 leading-relaxed">
                    💡 <strong className="text-slate-300">Việc cần làm tiếp theo:</strong> Hãy bấm nút bên dưới để soạn bài giới thiệu bản thân và tham gia nhóm Facebook. Khi được duyệt vào nhóm, bạn chỉ cần dán bài để chào sân và kết nối cùng mọi người!
                  </p>
                </div>
              </div>

              {/* Nút CTA duy nhất mở phần soạn bài */}
              {!showComposer ? (
                <div>
                  <button
                    type="button"
                    onClick={() => setShowComposer(true)}
                    className="w-full inline-flex items-center justify-center px-5 py-3.5 rounded-xl text-sm font-bold bg-[#C9A961] hover:bg-[#A98B45] text-[#14130F] transition-all cursor-pointer uppercase tracking-wider shadow-lg shadow-[#C9A961]/20 active:scale-[0.98]"
                  >
                    <PenLine className="w-4 h-4 mr-2" />
                    Soạn bài giới thiệu lên Facebook
                  </button>
                </div>
              ) : (
                <div className="bg-white/5 border border-white/10 rounded-2xl p-5 space-y-4">
                  <div className="flex items-center justify-between pb-3 border-b border-white/10">
                    <div>
                      <p className="text-sm font-bold text-[#F5F4F0] flex items-center gap-1.5">
                        <PenLine className="w-4 h-4 text-[#C9A961]" />
                        Soạn bài giới thiệu lên Facebook
                      </p>
                      <p className="text-[11px] text-slate-400 mt-0.5">
                        Chọn các ý bên dưới hoặc chỉnh sửa trực tiếp nội dung bài viết
                      </p>
                    </div>
                    <button
                      type="button"
                      onClick={() => {
                        setShowComposer(false);
                        setOpenDropdown(null);
                      }}
                      className="text-xs text-slate-400 hover:text-slate-200 px-2 py-1 rounded transition-colors cursor-pointer"
                    >
                      Thu gọn
                    </button>
                  </div>

                  {/* Các nhóm dropdown */}
                  <div className="space-y-3">
                    {INTRO_OPTIONS.map((g) => {
                      const selectedValues = introSel[g.key] || [];
                      const isOpen = openDropdown === g.key;

                      return (
                        <div key={g.key} className="space-y-1.5 relative">
                          <label className="text-xs font-semibold text-slate-300 flex items-center justify-between">
                            <span>
                              {g.label}
                              {g.multi && (
                                <span className="text-[11px] font-normal text-slate-500 ml-1.5">
                                  (chọn nhiều)
                                </span>
                              )}
                            </span>
                            {selectedValues.length > 0 && (
                              <span className="text-[10px] text-[#C9A961] font-medium">
                                Đã chọn {selectedValues.length}
                              </span>
                            )}
                          </label>

                          <button
                            type="button"
                            onClick={() => setOpenDropdown(isOpen ? null : g.key)}
                            className={`w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl border text-left text-xs transition-all cursor-pointer ${
                              isOpen
                                ? "bg-white/10 border-[#C9A961] ring-1 ring-[#C9A961]/30"
                                : selectedValues.length > 0
                                ? "bg-white/5 border-white/20 text-[#F5F4F0]"
                                : "bg-white/5 border-white/10 text-slate-400 hover:border-white/20"
                            }`}
                          >
                            <span className="truncate pr-2">
                              {selectedValues.length > 0
                                ? selectedValues.join(", ")
                                : g.placeholder}
                            </span>
                            <ChevronDown
