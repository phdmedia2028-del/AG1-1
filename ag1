import React, { useState, useEffect, useCallback } from "react";
import {
  collection, getDocs, deleteDoc, doc, getDoc, setDoc, orderBy, query,
} from "firebase/firestore";
import {
  GoogleAuthProvider, signInWithPopup, signOut, onAuthStateChanged, User,
} from "firebase/auth";
import { db, auth } from "../firebase";
import { WaitlistEntry, CoachingSettings, formatStartMonth } from "../waitlistTypes";
import { Trash2, Download, LogOut, Loader2, ShieldAlert, Save } from "lucide-react";

const ROOT_ADMIN_EMAIL = "ntunga.26@gmail.com";
const SECONDARY_ROOT_EMAIL = "tunganhhh.nl@gmail.com";

export default function AdminPage() {
  const [user, setUser] = useState<User | null>(null);
  const [authReady, setAuthReady] = useState(false);
  const [isAdmin, setIsAdmin] = useState(false);
  const [entries, setEntries] = useState<WaitlistEntry[]>([]);
  const [settings, setSettings] = useState<CoachingSettings>({ slotsFilled: 8, slotsTotal: 8 });
  const [loading, setLoading] = useState(false);
  const [savingSettings, setSavingSettings] = useState(false);
  const [expandedId, setExpandedId] = useState<string | null>(null);

  useEffect(() => {
    const unsub = onAuthStateChanged(auth, async (u) => {
      setUser(u);
      if (u?.email) {
        if (u.email === ROOT_ADMIN_EMAIL || u.email === SECONDARY_ROOT_EMAIL) {
          setIsAdmin(true);
        } else {
          try {
            const adminDoc = await getDoc(doc(db, "admins", u.email));
            setIsAdmin(adminDoc.exists());
          } catch { setIsAdmin(false); }
        }
      } else {
        setIsAdmin(false);
      }
      setAuthReady(true);
    });
    return () => unsub();
  }, []);

  const loadData = useCallback(async () => {
    setLoading(true);
    try {
      const q = query(collection(db, "waitlist"), orderBy("createdAt", "asc"));
      const snap = await getDocs(q);
      setEntries(snap.docs.map((d) => ({ id: d.id, ...(d.data() as Omit<WaitlistEntry, "id">) })));
      const sDoc = await getDoc(doc(db, "settings", "coaching"));
      if (sDoc.exists()) {
        setSettings(sDoc.data() as CoachingSettings);
      } else {
        const defaultSettings: CoachingSettings = { slotsFilled: 8, slotsTotal: 8 };
        setSettings(defaultSettings);
        await setDoc(doc(db, "settings", "coaching"), defaultSettings);
      }
    } catch { /* ignore */ }
    setLoading(false);
  }, []);

  useEffect(() => { if (isAdmin) loadData(); }, [isAdmin, loadData]);

  const handleLogin = async () => {
    try { await signInWithPopup(auth, new GoogleAuthProvider()); } catch { /* ignore */ }
  };

  const handleDelete = async (id: string, name: string) => {
    if (!window.confirm(`Xóa bản ghi của "${name}"? Thao tác này không thể hoàn tác.`)) return;
    try {
      await deleteDoc(doc(db, "waitlist", id));
      setEntries((prev) => prev.filter((e) => e.id !== id));
    } catch { window.alert("Không xóa được. Kiểm tra lại quyền truy cập."); }
  };

  const handleSaveSettings = async () => {
    setSavingSettings(true);
    try {
      await setDoc(doc(db, "settings", "coaching"), {
        slotsFilled: Number(settings.slotsFilled),
        slotsTotal: Number(settings.slotsTotal),
      });
    } catch { window.alert("Không lưu được. Kiểm tra lại quyền truy cập."); }
    setSavingSettings(false);
  };

  const exportCSV = () => {
    const headers = ["STT", "Họ tên", "Zalo", "Giờ/ngày", "Hành trình", "Lý do phù hợp", "Ngân sách", "Bắt đầu từ", "Thời điểm đăng ký"];
    const rows = entries.map((e, i) => [
      i + 1, e.name, e.zalo, e.hoursPerDay, e.journey, e.whyBestFit, e.budget,
      formatStartMonth(e.startMonth), new Date(e.createdAt).toLocaleString("vi-VN"),
    ]);
    const esc = (v: unknown) => `"${String(v ?? "").replace(/"/g, '""')}"`;
    const csv = "\uFEFF" + [headers, ...rows].map((r) => r.map(esc).join(",")).join("\n");
    const url = URL.createObjectURL(new Blob([csv], { type: "text/csv;charset=utf-8;" }));
    const a = document.createElement("a");
    a.href = url;
    a.download = `hang-cho-coaching-${new Date().toISOString().slice(0, 10)}.csv`;
    a.click();
    URL.revokeObjectURL(url);
  };

  if (!authReady) {
    return (
      <div className="min-h-screen bg-[#14130F] flex items-center justify-center">
        <Loader2 className="w-7 h-7 text-[#C9A961] animate-spin" />
      </div>
    );
  }

  if (!user) {
    return (
      <div className="min-h-screen bg-[#14130F] flex items-center justify-center p-4">
        <div className="bg-white/5 border border-[#C9A961]/25 rounded-3xl p-9 max-w-sm w-full text-center space-y-5">
          <h1 className="font-display font-extrabold text-xl text-[#F5F4F0]">Khu vực quản trị</h1>
          <p className="text-sm text-slate-400">Đăng nhập bằng tài khoản Google được cấp quyền.</p>
          <button onClick={handleLogin} className="w-full px-6 py-3.5 rounded-xl text-sm font-bold bg-[#C9A961] hover:bg-[#A98B45] text-[#14130F] transition-all cursor-pointer">
            Đăng nhập với Google
          </button>
        </div>
      </div>
    );
  }

  if (!isAdmin) {
    return (
      <div className="min-h-screen bg-[#14130F] flex items-center justify-center p-4">
        <div className="bg-white/5 border border-red-500/25 rounded-3xl p-9 max-w-sm w-full text-center space-y-5">
          <ShieldAlert className="w-10 h-10 text-red-400 mx-auto" />
          <div className="space-y-1.5">
            <h1 className="font-display font-extrabold text-lg text-[#F5F4F0]">Không có quyền truy cập</h1>
            <p className="text-sm text-slate-400 break-all">{user.email}</p>
          </div>
          <button onClick={() => signOut(auth)} className="w-full px-6 py-3 rounded-xl text-sm font-bold bg-white/5 border border-[#C9A961]/25 text-slate-300 hover:bg-white/10 transition-all cursor-pointer">
            Đăng xuất
          </button>
        </div>
      </div>
    );
  }

  return (
    <div className="min-h-screen bg-[#14130F] text-[#F5F4F0] p-4 sm:p-8">
      <div className="max-w-7xl mx-auto space-y-7">

        {/* Header */}
        <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div>
            <h1 className="font-display font-extrabold text-2xl">Hàng chờ Coaching</h1>
            <p className="text-xs text-slate-500 mt-1">{user.email}</p>
          </div>
          <div className="flex gap-2.5">
            <button onClick={exportCSV} className="inline-flex items-center px-4 py-2.5 rounded-xl text-xs font-bold bg-[#C9A961] hover:bg-[#A98B45] text-[#14130F] transition-all cursor-pointer">
              <Download className="w-4 h-4 mr-1.5" /> Xuất CSV
            </button>
            <button onClick={() => signOut(auth)} className="inline-flex items-center px-4 py-2.5 rounded-xl text-xs font-bold bg-white/5 border border-[#C9A961]/25 text-slate-300 hover:bg-white/10 transition-all cursor-pointer">
              <LogOut className="w-4 h-4 mr-1.5" /> Đăng xuất
            </button>
          </div>
        </div>

        {/* Slot settings */}
        <div className="bg-white/5 border border-[#C9A961]/20 rounded-2xl p-5 flex flex-wrap items-end gap-4">
          <div className="space-y-1.5">
            <label className="text-xs font-semibold text-slate-400 block">Slot đang coaching</label>
            <input
              type="number" min={0} max={settings.slotsTotal}
              value={settings.slotsFilled}
              onChange={(e) => setSettings((s) => ({ ...s, slotsFilled: Number(e.target.value) }))}
              className="w-24 bg-white/5 border border-[#C9A961]/25 rounded-xl px-3 py-2.5 text-sm focus:outline-none focus:border-[#C9A961]"
            />
          </div>
          <span className="text-slate-500 pb-3">/</span>
          <div className="space-y-1.5">
            <label className="text-xs font-semibold text-slate-400 block">Tổng slot (tối đa 8)</label>
            <input
              type="number" min={1} max={8}
              value={settings.slotsTotal}
              onChange={(e) => setSettings((s) => ({ ...s, slotsTotal: Math.min(8, Number(e.target.value)) }))}
              className="w-24 bg-white/5 border border-[#C9A961]/25 rounded-xl px-3 py-2.5 text-sm focus:outline-none focus:border-[#C9A961]"
            />
          </div>
          <button onClick={handleSaveSettings} disabled={savingSettings} className="inline-flex items-center px-4 py-2.5 rounded-xl text-xs font-bold bg-[#C9A961] hover:bg-[#A98B45] text-[#14130F] transition-all cursor-pointer disabled:opacity-50">
            {savingSettings ? <Loader2 className="w-4 h-4 animate-spin" /> : <><Save className="w-4 h-4 mr-1.5" /> Lưu</>}
          </button>
          <div className="ml-auto text-sm text-slate-400">
            Tổng số đăng ký: <strong className="text-[#C9A961] font-bold">{entries.length}</strong>
          </div>
        </div>

        {/* Table */}
        {loading ? (
          <div className="flex justify-center py-16"><Loader2 className="w-7 h-7 text-[#C9A961] animate-spin" /></div>
        ) : entries.length === 0 ? (
          <p className="text-center text-slate-500 py-16 text-sm">Chưa có bản ghi nào.</p>
        ) : (
          <div className="space-y-2.5">
            {entries.map((e, i) => (
              <div key={e.id} className="bg-white/5 border border-[#C9A961]/15 rounded-2xl overflow-hidden">
                <div className="p-4 flex flex-wrap items-center gap-4">
                  <span className="text-xs font-mono font-bold text-[#C9A961] bg-[#C9A961]/10 border border-[#C9A961]/25 px-2 py-1 rounded shrink-0">#{i + 1}</span>
                  <div className="min-w-[140px]">
                    <p className="font-bold text-sm">{e.name}</p>
                    <p className="text-xs text-slate-500 font-mono">{e.zalo}</p>
                  </div>
                  <div className="text-xs text-slate-400 min-w-[130px]">{e.hoursPerDay}</div>
                  <div className="text-xs text-slate-400 min-w-[110px]">{e.budget}</div>
                  <div className="text-xs text-slate-400 min-w-[110px]">{formatStartMonth(e.startMonth)}</div>
